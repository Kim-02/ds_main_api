# SQLite (새 모델용)
JETSON_DB_URL=sqlite+aiosqlite:///./jetson.db
CORPORATE_DB_URL=postgresql+asyncpg://user:password@corporate-host:5432/corporate_db

# MariaDB (기존 Jetson DB)
MARIADB_HOST=127.0.0.1
MARIADB_USER=root
MARIADB_PASSWORD=ekthf123
MARIADB_DB_NAME=ON_SAFE
MARIADB_PORT=3306

# MQTT Broker (local on edge device)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# vLLM Server
VLLM_BASE_URL=http://localhost:1111/v1
VLLM_MODEL=/media/ds/DATA/models/Qwen2.5-VL-3B
VLLM_API_KEY=test-key
VLLM_AUTOSTART=true
VLLM_VENV_ACTIVATE=~/vllm-jetson-v092-torch27/bin/activate
VLLM_WORKDIR=~/vllm-0.9.2-src
VLLM_SERVE_MODEL_PATH=/media/ds/DATA/models/Qwen2.5-VL-3B
VLLM_HOST=0.0.0.0
VLLM_PORT=1111
VLLM_DTYPE=float16
VLLM_GPU_MEMORY_UTILIZATION=0.5
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=3
VLLM_MAX_NUM_BATCHED_TOKENS=4096
VLLM_LIMIT_MM_PER_PROMPT=image=1,video=0
VLLM_STARTUP_TIMEOUT_SECONDS=600
VLLM_STARTUP_POLL_SECONDS=3.0
VLLM_LOG_PATH=logs/vllm_server.log
VLLM_PROGRESS_PATH=logs/vllm_startup_progress.json

# Camera
FRAME_BUFFER_MINUTES=10
FRAME_BUFFER_SECONDS=10
YOLO_MODEL_PATH=/media/ds/DATA/yolo_final/0507_best.engine
YOLO_CONFIDENCE=0.45
YOLO_PRELOAD_ON_STARTUP=true
YOLO_WARMUP_ON_STARTUP=true
FIRE_PIPELINE_YOLO_MODEL_PATH=/media/ds/DATA/yolo_final/0507_best.engine

# Detection Thresholds (defaults, overridden per sensor in DB)
DEFAULT_TEMP_THRESHOLD=35.0
DEFAULT_HEARTRATE_THRESHOLD=120

# Firebase (FCM push)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# DB Sync
DB_SYNC_INTERVAL_SECONDS=300

# mDNS service name
MDNS_SERVICE_NAME=_onesafer-sensor._tcp.local.

# API
API_HOST=0.0.0.0
API_PORT=8080
DEBUG=false
