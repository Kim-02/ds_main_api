# MariaDB (기존 Jetson DB)
MARIADB_HOST=127.0.0.1
MARIADB_USER=root
MARIADB_PASSWORD=ekthf123
MARIADB_DB_NAME=ON_SAFE
MARIADB_PORT=3306

# MQTT Broker (local on edge device)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# vLLM Server — 기본 경로/인증
VLLM_BASE_URL=http://localhost:1111/v1
VLLM_MODEL=/media/ds/DATA/models/Qwen2.5-VL-3B
VLLM_API_KEY=test-key
VLLM_AUTOSTART=true
VLLM_VENV_ACTIVATE=~/vllm-jetson-v092-torch27/bin/activate
VLLM_WORKDIR=~/vllm-0.9.2-src
VLLM_SERVE_MODEL_PATH=/media/ds/DATA/models/Qwen2.5-VL-3B
VLLM_HOST=0.0.0.0
VLLM_PORT=1111
VLLM_DTYPE=float16
VLLM_LOG_PATH=logs/vllm_server.log
VLLM_PROGRESS_PATH=logs/vllm_startup_progress.json

# vLLM 성능 — 실시간성 최우선 (안되면 아래 주석 참고)
VLLM_GPU_MEMORY_UTILIZATION=0.75  # OOM 시 → 0.80 → 0.75
VLLM_MAX_MODEL_LEN=2048            # 프롬프트+출력 최대 토큰. OOM 시 → 1536 (충분함)
VLLM_MAX_NUM_SEQS=1                # Jetson 단일 GPU: 1이면 충분
VLLM_MAX_NUM_BATCHED_TOKENS=2048   # MAX_MODEL_LEN * MAX_NUM_SEQS
VLLM_LIMIT_MM_PER_PROMPT=image=1,video=0
VLLM_STARTUP_TIMEOUT_SECONDS=600
VLLM_STARTUP_POLL_SECONDS=3.0

# VLM 타임셰어 — 요청 큐 동시 실행 수
VLM_TIMESHARE_MAX_CONCURRENT=1     # Jetson: 1이 최적 (vLLM이 내부 배칭 담당)
VLM_TIMESHARE_COOLDOWN_SECONDS=0.1

# Camera / RTSP
FRAME_BUFFER_SECONDS=10            # 롤링 버퍼 보존 시간 (초). VLM은 아래 CONTEXT_SECONDS만 사용
FRAME_BUFFER_SAMPLE_INTERVAL_SECONDS=0.5
RTSP_RECONNECT_DELAY_SECONDS=2.0
YOLO_MODEL_PATH=/media/ds/DATA/yolo_final/0507_best.engine
YOLO_CONFIDENCE=0.45
YOLO_PRELOAD_ON_STARTUP=true
YOLO_WARMUP_ON_STARTUP=true

# VLM에 넘기는 YOLO 컨텍스트 — 프롬프트 크기 결정
CCTV_VLM_YOLO_CONTEXT_SECONDS=8.0      # 몇 초치 프레임을 YOLO 분석에 쓸지. 길수록 행동 패턴 정확
CCTV_VLM_YOLO_CONTEXT_MAX_FRAMES=8     # delta 값 풍부하게 유지 (비틀거림 감지 품질에 직결)
CCTV_VLM_YOLO_CONTEXT_PROMPT_MAX_CHARS=750  # person_path·delta·person_tracks 전체 포함 가능한 크기

# VLM 프롬프트/출력 제한
CAMERA_VLM_REQUEST_TIMEOUT_SECONDS=90
CAMERA_VLM_PROMPT_MAX_CHARS=3000       # 전체 프롬프트 최대 길이 (줄이면 빠름)
CAMERA_VLM_RETRY_PROMPT_MAX_CHARS=800  # 프롬프트 초과 시 재시도용 압축 프롬프트
CAMERA_VLM_MAX_TOKENS=192              # VLM 출력 토큰 수. 부족 시 → 256

# Fire pipeline
FIRE_PIPELINE_ENABLED=false
FIRE_PIPELINE_YOLO_MODEL_PATH=/media/ds/DATA/yolo_final/0507_best.engine
FIRE_PIPELINE_SAMPLE_GAP_SECONDS=0.5
FIRE_PIPELINE_VLM_GAP_SECONDS=10.0
FIRE_PIPELINE_BUFFER_STARTUP_WAIT_SECONDS=5.0
FIRE_PIPELINE_BUFFER_RECENT_SECONDS=1.5
FIRE_PIPELINE_BUFFER_EMPTY_SLEEP_SECONDS=0.1
FIRE_PIPELINE_BUFFER_DUPLICATE_SLEEP_SECONDS=0.05
FIRE_PIPELINE_BUFFER_WAIT_LOG_INTERVAL_SECONDS=30.0
FIRE_PIPELINE_NORMALIZED_KEEP_COUNT=3
FIRE_PIPELINE_QUEUE_SIZE=3
FIRE_PIPELINE_ABNORMAL_MISSING_LIMIT=4
FIRE_PIPELINE_VALIDATION_COMPARE_HEIGHT=360
FIRE_PIPELINE_VLLM_TIMEOUT_SECONDS=30
FIRE_PIPELINE_VALIDATION_MAX_TOKENS=128
FIRE_PIPELINE_VALIDATION_PROMPT_MAX_CHARS=2600
FIRE_PIPELINE_ANALYSIS_MAX_TOKENS=128
FIRE_PIPELINE_ANALYSIS_PROMPT_MAX_CHARS=3000

# Detection thresholds
DEFAULT_TEMP_THRESHOLD=35.0
DEFAULT_HEARTRATE_THRESHOLD=80
SENSOR_REGISTER_INTERVAL_MS=5000
WATCH_PIPELINE_INTERVAL_SECONDS=30
WATCH_HR_STALE_SECONDS=15
WATCH_ALERT_DURATION_MS=5000
WATCH_ALERT_RESET_AFTER_MS=5000
WATCH_CAMERA_VLM_SESSION_SECONDS=30
REST_FORCED_REST_WORK_MINUTES=120
REST_DEFAULT_AGE=40
REST_DEFAULT_GENDER=1
REST_DEFAULT_HEIGHT_CM=170.0
REST_DEFAULT_WEIGHT_KG=70.0
REST_DEFAULT_WORK_DURATION_MIN=0
TEMPERATURE_VLM_THRESHOLD=29.0
TEMPERATURE_VLM_CHECK_INTERVAL_SECONDS=10
TEMPERATURE_VLM_SESSION_SECONDS=30
TEMPERATURE_VLM_STALE_SECONDS=60

# Firebase (FCM push)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# DB Sync
DB_SYNC_INTERVAL_SECONDS=300

# mDNS
MDNS_SERVICE_TYPE=_jetsonhub._tcp.local.
MDNS_SERVICE_NAME=OnSafe Jetson

# API
API_HOST=0.0.0.0
API_PORT=8080
DEBUG=false
